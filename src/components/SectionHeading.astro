---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}

const { title, href, linkLabel = 'すべて見る', id } = Astro.props;
---

<div class="heading">
  <h2 id={id}>{title}</h2>
  {href && <a href={href}>{linkLabel} <span aria-hidden="true">→</span></a>}
</div>

<style>
  .heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  h2 {
    font-size: 1.25rem;
    padding-left: 12px;
    border-left: 5px solid var(--accent);
  }

  a {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
