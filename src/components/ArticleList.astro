---
import { ARTICLE_CATEGORIES } from '../data/labels';
import { sourceOf } from '../data';
import type { Article } from '../data/types';
import { formatMonthDay, relativeDay } from '../lib/format';
import Badge from './Badge.astro';

interface Props {
  articles: Article[];
  showSummary?: boolean;
}

const { articles, showSummary = false } = Astro.props;
const isExternal = (href: string) => href.startsWith('http');
---

<ul class="list">
  {
    articles.map((a) => {
      const cat = ARTICLE_CATEGORIES[a.category];
      const source = sourceOf(a.sourceId);
      return (
        <li class="row">
          <time class="date" datetime={a.publishedAt.toISOString()}>
            <span class="md">{formatMonthDay(a.publishedAt)}</span>
            <span class="rel muted">{relativeDay(a.publishedAt)}</span>
          </time>
          <div class="body">
            <div class="meta">
              <Badge tone={cat.tone}>{cat.label}</Badge>
              {source && <span class="small muted">{source.name}</span>}
            </div>
            <a
              class="title"
              href={a.sourceUrl}
              target={isExternal(a.sourceUrl) ? '_blank' : undefined}
              rel={isExternal(a.sourceUrl) ? 'noopener noreferrer' : undefined}
            >
              {a.title}
              <span aria-hidden="true" class="ext">↗</span>
            </a>
            {showSummary && <p class="summary small muted">{a.summary}</p>}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .list {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    padding: 12px 16px;
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  .date {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    padding-top: 2px;
  }

  .md {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .rel {
    font-size: 0.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-bottom: 2px;
  }

  .title {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .title:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .ext {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .summary {
    margin-top: 2px;
  }
</style>
