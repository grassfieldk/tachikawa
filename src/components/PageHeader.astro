---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}

const { title, lead, crumbs = [] } = Astro.props;
---

<div class="page-header">
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav class="crumbs small" aria-label="パンくず">
          <ol>
            <li>
              <a href="/">トップ</a>
            </li>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    {lead && <p class="lead muted">{lead}</p>}
  </div>
</div>

<style>
  .page-header {
    padding-block: 28px 20px;
    background: linear-gradient(180deg, var(--accent-weak), transparent);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-bottom: 8px;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    font-size: 1.75rem;
  }

  .lead {
    margin-top: 6px;
    max-width: 44em;
  }
</style>
