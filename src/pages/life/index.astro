---
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';

export const prerender = true;

// リンク先は公式サイトのページに差し替える（いまはダミー）
const groups = [
  {
    id: 'waste',
    title: 'ごみ・リサイクル',
    text: '収集日や分別の方法を調べる',
    links: ['収集日の調べ方', '分別の辞典', '粗大ごみの申込み'],
  },
  {
    id: 'kids',
    title: '子育て・教育',
    text: '保育施設、手当、学校のこと',
    links: ['保育施設の申込み', '児童手当', '学校と学区'],
  },
  {
    id: 'safety',
    title: '防災・防犯',
    text: '災害への備えと、地域の安全',
    links: ['ハザードマップ', '避難所の一覧', '防犯情報'],
  },
  {
    id: 'apply',
    title: '手続き・届出',
    text: '引越しや証明書など、窓口の手続き',
    links: ['引越しの手続き', '住民票・印鑑証明', 'マイナンバー'],
  },
  {
    id: 'health',
    title: '健康・福祉',
    text: '健診、予防接種、相談窓口',
    links: ['健康診査', '予防接種', '介護・福祉の相談'],
  },
  {
    id: 'facility',
    title: '施設・予約',
    text: '公共施設の利用と予約',
    links: ['公共施設の予約', '図書館', 'スポーツ施設'],
  },
];
---

<Base title="暮らし・行政" description="ごみ、子育て、防災、手続きなど、暮らしに関わる行政情報">
  <PageHeader
    title="暮らし・行政"
    lead="暮らしに関わる行政の情報を、目的別にまとめています。詳しい内容は市の公式サイトで確認できます。"
    crumbs={[{ label: '暮らし・行政' }]}
  />
  <div class="container section stack" style="--gap: 16px">
    <p class="note small">リンク先はダミーです。公開時は市の公式ページに差し替えます。</p>
    <div class="grid grid-3">
      {
        groups.map((g) => (
          <section class="card raised" id={g.id}>
            <h2>{g.title}</h2>
            <p class="small muted">{g.text}</p>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href="#">
                    {l} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .note {
    padding: 10px 14px;
    background: var(--tone-amber-bg);
    color: var(--tone-amber-fg);
    border-radius: var(--radius-sm);
  }

  section {
    scroll-margin-top: 120px;
  }

  h2 {
    font-size: 1.125rem;
  }

  ul {
    margin-top: 10px;
    border-top: 1px solid var(--line);
  }

  li a {
    display: block;
    padding: 9px 2px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-weight: 600;
  }

  li a:hover {
    text-decoration: underline;
  }
</style>
