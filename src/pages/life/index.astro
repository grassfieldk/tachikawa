---
import Base from '../../layouts/Base.astro';
import { LifeView } from '../../views/StaticViews';

export const prerender = true;

// リンク先は公式サイトのページに差し替える（いまはダミー）
const groups = [
  {
    id: 'waste',
    title: 'ごみ・リサイクル',
    links: ['収集日の調べ方', '分別の辞典', '粗大ごみの申込み'],
  },
  {
    id: 'kids',
    title: '子育て・教育',
    links: ['保育施設の申込み', '児童手当', '学校と学区'],
  },
  {
    id: 'safety',
    title: '防災・防犯',
    links: ['ハザードマップ', '避難所の一覧', '防犯情報'],
  },
  {
    id: 'apply',
    title: '手続き・届出',
    links: ['引越しの手続き', '住民票・印鑑証明', 'マイナンバー'],
  },
  {
    id: 'health',
    title: '健康・福祉',
    links: ['健康診査', '予防接種', '介護・福祉の相談'],
  },
  {
    id: 'facility',
    title: '施設・予約',
    links: ['公共施設の予約', '図書館', 'スポーツ施設'],
  },
];
---

<Base title="暮らし・行政" description="ごみ、子育て、防災、手続きなど、行政の情報へのリンク">
  <LifeView groups={groups} />
</Base>
