---
import { getArea, listEvents, listPlaces } from '../../data';
import Base from '../../layouts/Base.astro';
import { eventMarkers, placeMarkers } from '../../lib/markers';
import { eventView, placeView } from '../../lib/views';
import { AreaDetailView } from '../../views/DetailViews';

const area = await getArea(Astro.params.slug ?? '');
if (!area) return Astro.rewrite('/404');

const [events, places] = await Promise.all([
  listEvents({ areaSlug: area.code }),
  listPlaces({ areaSlug: area.code }),
]);
const now = new Date();
---

<Base title={area.name} description={area.summary}>
  <AreaDetailView
    client:load
    area={area}
    events={events.map((e) => eventView(e, now))}
    places={places.map(placeView)}
    markers={[...placeMarkers(places), ...eventMarkers(events)]}
  />
</Base>
