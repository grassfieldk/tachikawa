---
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません">
  <div class="container section notfound">
    <p class="code">404</p>
    <h1>ページが見つかりません</h1>
    <p class="muted">URL が間違っているか、ページが移動または削除された可能性があります。</p>
    <p class="actions">
      <a class="btn" href="/">トップへ戻る</a>
      <a class="btn ghost" href="/search">サイト内を検索する</a>
    </p>
  </div>
</Base>

<style>
  .notfound {
    padding-block: 64px;
    text-align: center;
  }

  .code {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--accent);
  }

  h1 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
</style>
