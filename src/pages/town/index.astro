---
import Base from '../../layouts/Base.astro';
import { TownView } from '../../views/StaticViews';

export const prerender = true;

const items = [
  { href: '/areas', title: '地区ガイド', text: '町ごとの概要と、その地区の施設・イベント' },
  { href: '/history', title: '歴史', text: '鉄道の開業から現在までの年表' },
  { href: '/access', title: '交通', text: '鉄道、モノレール、バス、主要な道路' },
  { href: '/stats', title: '統計', text: '人口、世帯数、年齢構成' },
  { href: '/map', title: 'マップ', text: '施設、お店、避難所、イベント会場の地図' },
];
---

<Base title="街を知る" description="立川の地区、歴史、交通、統計">
  <TownView items={items} />
</Base>
