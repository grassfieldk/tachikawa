---
import ArticleList from '../../components/ArticleList.astro';
import FilterChips from '../../components/FilterChips.astro';
import PageHeader from '../../components/PageHeader.astro';
import { listArticles } from '../../data';
import { ARTICLE_CATEGORIES } from '../../data/labels';
import type { ArticleCategory } from '../../data/types';
import Base from '../../layouts/Base.astro';
import { formatMonthLabel } from '../../lib/format';

const param = Astro.url.searchParams.get('category');
const category =
  param && param in ARTICLE_CATEGORIES ? (param as ArticleCategory) : undefined;

const articles = await listArticles({ category });

const groups: { label: string; items: typeof articles }[] = [];
for (const a of articles) {
  const label = formatMonthLabel(a.publishedAt);
  const last = groups.at(-1);
  if (last?.label === label) last.items.push(a);
  else groups.push({ label, items: [a] });
}

const options = Object.entries(ARTICLE_CATEGORIES).map(([value, c]) => ({ value, label: c.label }));
---

<Base title="お知らせ" description="立川市と地域の最新のお知らせ">
  <PageHeader
    title="お知らせ"
    lead="市の公式発表を中心に、暮らしに関わる最新のお知らせを新しい順に掲載しています。"
    crumbs={[{ label: 'お知らせ' }]}
  />
  <div class="container section stack" style="--gap: 20px">
    <FilterChips label="分類" param="category" options={options} />
    <p class="small muted">{articles.length} 件</p>
    {
      groups.length > 0 ? (
        groups.map((g) => (
          <section class="stack" style="--gap: 10px">
            <h2 class="month">{g.label}</h2>
            <ArticleList articles={g.items} showSummary />
          </section>
        ))
      ) : (
        <p class="empty">該当するお知らせはありません</p>
      )
    }
  </div>
</Base>

<style>
  .month {
    font-size: 1rem;
    color: var(--muted);
  }
</style>
