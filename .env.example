# 値はすべてダミー
# 実際の値は .env に書き、コミットしない

# サイトの公開 URL（実ドメインは .env にだけ書く）
SITE_ORIGIN=

# DB 接続（サイト用は読み取り専用、収集用は書き込み可）
DATABASE_URL_WEB=postgres://app_web:CHANGE_ME@localhost:5432/tachikawa
DATABASE_URL_COLLECTOR=postgres://app_collector:CHANGE_ME@localhost:5432/tachikawa

# 収集時の抽出と要約に使う Claude API
ANTHROPIC_API_KEY=

# 情報提供フォーム（段階 3）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
